{
  "name": "skillpulse-ai",
  "version": "1.0.0",
  "description": "SkillPulse AI — gig worker skill gap analyzer powered by Gemini",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "build": "cd client && npm install && npm run build",
    "dev": "concurrently \"nodemon server/index.js\" \"cd client && npm start\"",
    "postinstall": "cd client && npm install"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "nodemon": "^3.1.0",
    "stripe": "^15.7.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}