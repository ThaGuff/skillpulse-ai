# ── Required ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Stripe (for paywall) ──────────────────────────────────
# Get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...       # your $7.99/mo recurring price ID

# ── App ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
# Set this to your Railway public URL after first deploy:
RAILWAY_PUBLIC_DOMAIN=https://your-app.railway.app
