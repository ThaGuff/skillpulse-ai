# ── AI Engine ─────────────────────────────────────────────────────────────────
# Set to "ollama" to use your own Ollama server, or "gemini" (default)
LLM_ENGINE=gemini

# ── Ollama (when LLM_ENGINE=ollama) ──────────────────────────────────────────
# URL of your Ollama server — local or a VPS/cloud instance
# Local dev:       http://localhost:11434
# ngrok tunnel:    https://abc123.ngrok.io
# VPS (Hetzner etc): http://YOUR_VPS_IP:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Gemini (fallback, or primary when LLM_ENGINE=gemini) ─────────────────────
# Get key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
RAILWAY_PUBLIC_DOMAIN=https://skillpulse.up.railway.app
